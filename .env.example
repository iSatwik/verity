# Supabase Postgres connection string (Transaction pooler, port 6543).
# Leave empty to use a local in-process Postgres (PGlite) for development.
DATABASE_URL=

# Google Gemini API key from https://aistudio.google.com (optional).
# Without it, Verity runs code checks only (all rule, fact, term, price, image and accessibility checks still work).
GEMINI_API_KEY=

# Optional: force a specific Gemini model. Default tries gemini-3.5-flash, then gemini-2.5-flash.
GEMINI_MODEL=

# Testing only: AI_MODE=mock returns fake AI answers to test the citation verifier without network access.
AI_MODE=

# --- Company AI server (optional) ---
# Point Verity at your own OpenAI-compatible server (Ollama, vLLM, LM Studio, LiteLLM...).
# When set, it is used for all AI work and content never goes to an outside AI service.
# Example for Ollama on the same machine: AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=llama3.2-vision
AI_BASE_URL=
AI_MODEL=
# Optional: a separate model for images, a bearer token, and a timeout.
AI_VISION_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=60000

# --- Sign-in ---
# Secret for signing session cookies (32+ random characters). If empty, one is derived from DATABASE_URL.
AUTH_SECRET=
# One-click demo sign-in for the four sample accounts. Set to "off" for a real deployment.
DEMO_SIGNIN=
